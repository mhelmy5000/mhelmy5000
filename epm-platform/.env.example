# ── Helm EPM environment (copy to .env) ─────────────────────────────────────
# Database (matches infra/docker-compose.yml)
DATABASE_URL="postgresql://helm:helm@localhost:5432/helm_epm?schema=public"
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://helm:helm@localhost:5672"

# ── AI providers (all optional — enable any subset) ─────────────────────────
# The AiRouter enables a provider only when its key/endpoint is present, and
# tries them in priority order (Anthropic → OpenAI → Gemini → Azure → Ollama).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# Local/on-prem private AI — no key required, just the endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ── Auth (Phase 1) ──────────────────────────────────────────────────────────
JWT_SECRET=change-me
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
